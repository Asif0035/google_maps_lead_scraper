[Unit]
Description=Google Maps Lead Scraper - Streamlit
After=network.target

[Service]
Type=simple

User=mapscraper
Group=mapscraper

WorkingDirectory=/opt/google-maps-scraper

Environment="PATH=/opt/google-maps-scraper/venv/bin"
Environment="PYTHONUNBUFFERED=1"

ExecStart=/opt/google-maps-scraper/venv/bin/streamlit run /opt/google-maps-scraper/dashboard.py --server.address=127.0.0.1 --server.port=8501 --server.headless=true --browser.gatherUsageStats=false

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
